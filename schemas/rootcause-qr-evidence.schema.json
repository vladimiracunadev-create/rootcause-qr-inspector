{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rootcause.local/rootcause-qr-evidence.v1.schema.json",
  "title": "RootCause QR Evidence v1",
  "type": "object",
  "required": [
    "schema",
    "product",
    "bundleId",
    "observedAt",
    "observation",
    "investigation",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "rootcause.evidence.qr.v1"
    },
    "product": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "RootCause QR Inspector" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": false
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "observation": {
      "type": "object",
      "required": [
        "source",
        "symbology",
        "contentKind",
        "sensitive",
        "payloadBytes",
        "payloadSha256",
        "redaction"
      ],
      "properties": {
        "source": { "type": "string" },
        "symbology": { "type": "string" },
        "contentKind": { "type": "string" },
        "sensitive": { "type": "boolean" },
        "payloadBytes": { "type": "integer", "minimum": 0 },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "redaction": {
          "enum": ["payload-omitted", "none-user-authorized"]
        },
        "rawPayload": { "type": "string" },
        "parsed": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "redaction": { "const": "payload-omitted" } },
            "required": ["redaction"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["rawPayload"] },
                { "required": ["parsed"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "investigation": {
      "$ref": "#/$defs/investigation"
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "assurance", "bundleHash"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "assurance": { "const": "checksum-only-not-authenticated" },
        "previousEvidenceHash": { "$ref": "#/$defs/sha256" },
        "bundleHash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "findingId": {
      "enum": [
        "authority-obfuscated",
        "authority-userinfo",
        "brand-domain-mismatch",
        "credential-lure-path",
        "download-dangerous-extension",
        "encoded-separator",
        "host-deep-subdomains",
        "host-empty",
        "host-hyphen-density",
        "host-ip-literal",
        "host-mixed-script",
        "host-private-or-local",
        "host-punycode",
        "host-shortener",
        "host-trailing-dot",
        "host-unicode",
        "opaque-binary-payload",
        "payment-instruction",
        "port-unusual",
        "redirect-nested-domain",
        "scheme-blocked",
        "sensitive-secret",
        "tracking-excessive",
        "transport-http",
        "url-control-character",
        "url-excessive-length"
      ]
    },
    "evidenceFact": {
      "type": "object",
      "required": ["id", "value"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "score", "confidence", "category", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/findingId" },
        "severity": { "enum": ["normal", "warning", "critical"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "category": {
          "enum": [
            "transport",
            "identity",
            "obfuscation",
            "destination",
            "credential",
            "download",
            "redirect",
            "sensitiveAction"
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceFact" }
        }
      },
      "additionalProperties": false
    },
    "investigation": {
      "type": "object",
      "required": [
        "schema",
        "engineVersion",
        "analyzedAt",
        "payloadSha256",
        "verdict",
        "findings",
        "hypotheses",
        "evaluatedRuleIds",
        "limitations"
      ],
      "properties": {
        "schema": { "const": "rootcause.qr-investigation.v1" },
        "engineVersion": { "type": "string" },
        "analyzedAt": { "type": "string", "format": "date-time" },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "verdict": {
          "type": "object",
          "required": ["severity", "score", "action"],
          "properties": {
            "severity": { "enum": ["normal", "warning", "critical"] },
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "action": { "enum": ["allow", "confirm", "inspectOnly", "block"] }
          },
          "additionalProperties": false
        },
        "normalizedHost": { "type": "string" },
        "effectiveUri": { "type": "string", "format": "uri" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "hypotheses": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "evaluatedRuleIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingId" },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation": {
            "properties": {
              "redaction": { "const": "payload-omitted" }
            },
            "required": ["redaction"]
          }
        },
        "required": ["observation"]
      },
      "then": {
        "properties": {
          "investigation": {
            "not": { "required": ["effectiveUri"] }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
